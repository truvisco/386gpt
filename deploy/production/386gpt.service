[Unit]
Description=386GPT API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grimlock
Group=grimlock
WorkingDirectory=/var/www/vhosts/api-386gpt.truvis.co/current
Environment=ADDRESS=127.0.0.1:20386
Environment=DATABASE_PATH=/var/www/vhosts/api-386gpt.truvis.co/shared/data/386gpt.db
Environment=HERMES_CONFIG=/etc/386gpt/hermes.yaml
ExecStart=/var/www/vhosts/api-386gpt.truvis.co/current/386gpt
Restart=always
RestartSec=2s
TimeoutStopSec=10s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/386gpt
ReadWritePaths=/var/www/vhosts/api-386gpt.truvis.co/shared/data

[Install]
WantedBy=multi-user.target
