{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-bootstra386.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:e2e": "node scripts/agent-ui.test.mjs",
    "test:access": "esbuild worker/index.ts --bundle --platform=node --format=esm --define:import.meta.env.DEV=false --outfile=node_modules/.tmp/access-worker.mjs && node scripts/access-worker.test.mjs"
  },
  "dependencies": {
    "bootstra.386": "https://codeload.github.com/kristopolous/BOOTSTRA.386/tar.gz/5a42e54220e5f96c4a2e3a7486c3865d480e32f4",
    "jose": "^6.2.2",
    "jquery": "^3.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/jquery": "^4.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.131.1",
    "ws": "^8.22.0"
  }
}
